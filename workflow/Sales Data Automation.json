    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n  const row = item.json;\n\n  return {\n    json: {\n      ...row,\n\n      // Text cleaning\n      order_id: String(row.order_id).trim(),\n      customer_id: String(row.customer_id).trim(),\n      product: String(row.product).trim(),\n      city: String(row.city).trim(),\n      salesperson: String(row.salesperson).trim(),\n\n      // Standardize categorical values\n      payment_method: String(row.payment_method)\n        .trim()\n        .toLowerCase()\n        .replace(/\\b\\w/g, char => char.toUpperCase()),\n\n      sales_channel: String(row.sales_channel)\n        .trim()\n        .toLowerCase()\n        .replace(/\\b\\w/g, char => char.toUpperCase()),\n\n      // Numeric cleaning\n      quantity: Number(row.quantity),\n      unit_price: Number(row.unit_price),\n      discount: Number(row.discount)\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1168,
        624
      ],
      "id": "535d6323-a2ae-4d2f-a5bb-59ba5cddfa84",
      "name": "Cleaning"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n  const row = item.json;\n\n  const quantity = Number(row.quantity);\n  const unitPrice = Number(row.unit_price);\n  const discount = Number(row.discount);\n\n  const grossRevenue = quantity * unitPrice;\n  const discountAmount = grossRevenue * discount;\n  const netRevenue = grossRevenue - discountAmount;\n\n  const date = new Date(row.order_date);\n\n  return {\n    json: {\n      ...row,\n\n      gross_revenue: grossRevenue,\n      discount_amount: discountAmount,\n      net_revenue: netRevenue,\n\n      order_year: date.getFullYear(),\n      order_month: date.getMonth() + 1,\n      order_month_name: date.toLocaleString(\"en-US\", {\n        month: \"long\"\n      })\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1168,
        768
      ],
      "id": "a639fed5-87fc-40f8-a06f-634d86821099",
      "name": "Transform"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nlet totalOrders = 0;\nlet totalQuantity = 0;\nlet grossRevenue = 0;\nlet totalDiscount = 0;\nlet netRevenue = 0;\n\nfor (const item of items) {\n  const row = item.json;\n\n  totalOrders += 1;\n  totalQuantity += Number(row.quantity) || 0;\n  grossRevenue += Number(row.gross_revenue) || 0;\n  totalDiscount += Number(row.discount_amount) || 0;\n  netRevenue += Number(row.net_revenue) || 0;\n}\n\nconst averageOrderValue =\n  totalOrders > 0\n    ? netRevenue / totalOrders\n    : 0;\n\nreturn [\n  {\n    json: {\n      total_orders: totalOrders,\n      total_quantity: totalQuantity,\n      gross_revenue: Number(grossRevenue.toFixed(2)),\n      total_discount: Number(totalDiscount.toFixed(2)),\n      net_revenue: Number(netRevenue.toFixed(2)),\n      average_order_value: Number(averageOrderValue.toFixed(2)),\n      report_id: \"SALES_KPI\",\n      \n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1184,
        960
      ],
      "id": "69c2d50f-cb82-47ac-89f1-93cb43d41520",
      "name": "kpis"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst citySummary = {};\n\nfor (const item of items) {\n  const row = item.json;\n\n  const city = row.city;\n  const revenue = Number(row.net_revenue) || 0;\n  const quantity = Number(row.quantity) || 0;\n\n  // Create city if it doesn't exist\n  if (!citySummary[city]) {\n    citySummary[city] = {\n      city: city,\n      orders: 0,\n      quantity: 0,\n      revenue: 0\n    };\n  }\n\n  // Add this order to the city\n  citySummary[city].orders += 1;\n  citySummary[city].quantity += quantity;\n  citySummary[city].revenue += revenue;\n}\n\n// Convert object into n8n items\nreturn Object.values(citySummary).map(city => ({\n  json: {\n    city: city.city,\n    orders: city.orders,\n    quantity: city.quantity,\n    revenue: Number(city.revenue.toFixed(2))\n  }\n}));"
      },
