    {
      "parameters": {
        "jsCode": "\nconst rows = $input.all().map(item => item.json);\n\n// Existing alerts have a first_detected_at value.\nconst previouslyAlerted = new Set(\n  rows\n    .filter(row => row.first_detected_at)\n    .map(row => String(row.order_id ?? \"\").trim())\n    .filter(Boolean)\n);\n\n// Keep only current invalid rows, excluding old alerts.\nconst currentInvalid = rows.filter(row =>\n  !row.first_detected_at &&\n  (row.is_valid === false ||\n   String(row.is_valid).toLowerCase() === \"false\")\n);\n\n// Keep one alert per order ID.\nconst uniqueNewAlerts = new Map();\n\nfor (const row of currentInvalid) {\n  const orderId = String(row.order_id ?? \"\").trim();\n\n  if (!orderId || previouslyAlerted.has(orderId)) {\n    continue;\n  }\n\n  if (!uniqueNewAlerts.has(orderId)) {\n    uniqueNewAlerts.set(orderId, {\n      order_id: orderId,\n      error_reason: String(row.error_reason ?? \"Data quality issue\"),\n      first_detected_at: new Date().toISOString(),\n    });\n  }\n}\n\nconst newAlerts = [...uniqueNewAlerts.values()];\nconst reasons = [...new Set(newAlerts.map(a => a.error_reason))];\n\nreturn [{\n  json: {\n    invalid_count: newAlerts.length,\n    reasons,\n    sample_orders: newAlerts.slice(0, 10).map(a => a.order_id),\n    new_alerts: newAlerts,\n  }\n}];\n"
      },
