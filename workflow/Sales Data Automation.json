    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst requiredFields = [\n  \"order_id\",\n  \"order_date\",\n  \"customer_id\",\n  \"product\",\n  \"quantity\",\n  \"unit_price\",\n  \"discount\"\n];\n\n// Count how many times each order_id appears\nconst orderCounts = {};\n\nfor (const item of items) {\n  const orderId = item.json.order_id;\n\n  if (orderId) {\n    orderCounts[orderId] = (orderCounts[orderId] || 0) + 1;\n  }\n}\n\n// Validate each row\nreturn items.map(item => {\n  const row = item.json;\n  const errors = [];\n\n  // 1. Missing required fields\n  for (const field of requiredFields) {\n    const value = row[field];\n\n    if (\n      value === undefined ||\n      value === null ||\n      String(value).trim() === \"\"\n    ) {\n      errors.push(`Missing ${field}`);\n    }\n  }\n\n  // 2. Invalid quantity\n  if (\n    row.quantity !== undefined &&\n    row.quantity !== null &&\n    String(row.quantity).trim() !== \"\"\n  ) {\n    if (Number(row.quantity) <= 0) {\n      errors.push(\"Invalid quantity\");\n    }\n  }\n\n  // 3. Invalid price\n  if (\n    row.unit_price !== undefined &&\n    row.unit_price !== null &&\n    String(row.unit_price).trim() !== \"\"\n  ) {\n    if (Number(row.unit_price) <= 0) {\n      errors.push(\"Invalid price\");\n    }\n  }\n\n  // 4. Invalid discount\n  if (\n    row.discount !== undefined &&\n    row.discount !== null &&\n    String(row.discount).trim() !== \"\"\n  ) {\n    const discount = Number(row.discount);\n\n    if (discount < 0 || discount > 1) {\n      errors.push(\"Invalid discount\");\n    }\n  }\n\n  // 5. Duplicate order\n  const orderId = row.order_id;\n\n  if (orderId && orderCounts[orderId] > 1) {\n    errors.push(\"Duplicate order\");\n  }\n\n  return {\n    json: {\n      ...row,\n\n      is_duplicate: orderId\n        ? orderCounts[orderId] > 1\n        : false,\n\n      is_valid: errors.length === 0,\n\n      error_reason: errors.join(\"; \")\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        352
      ],
